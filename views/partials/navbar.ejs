<!-- views/partials/navbar.ejs -->
<nav class="flex justify-between items-center p-4 bg-white shadow-sm">
    <!-- Contenedor del Logo y Nombre -->
    <div class="flex items-center space-x-3">
        <img src="/images/icon.svg" alt="Logo <%= nombreClinica %>" class="w-9 h-9">
        <div class="font-bold text-3xl text-teal-600 tracking-tight">
            <%= nombreClinica %>
        </div>
    </div>

    <!-- Enlaces de Navegación -->
    <div class="flex items-center space-x-6 font-semibold text-slate-600">
        <a href="/" class="<%= rutaActual === '/' ? 'text-teal-600  font-bold' : 'hover:text-teal-600' %>">Inicio</a>
        <a href="/servicios" class="<%= rutaActual === '/servicios' ? 'text-teal-600  font-bold' : 'hover:text-teal-600' %>">Servicios</a>
        <a href="/contacto" class="<%= rutaActual === '/contacto' ? 'text-teal-600 font-bold' : 'hover:text-teal-600' %>">Contacto</a>

        <!-- Bloque de Autenticación: cambia según haya o no sesión activa -->
        <% if (usuario) { %>
            <a href="/mascotas" class="<%= rutaActual.startsWith('/mascotas') ? 'text-teal-600 font-bold' : 'hover:text-teal-600' %>">Mascotas</a>
            <a href="/duenos" class="<%= rutaActual.startsWith('/duenos') ? 'text-teal-600 font-bold' : 'hover:text-teal-600' %>">Dueños</a>

            <div class="flex items-center space-x-4 pl-6 border-l border-slate-200">
                <span class="text-slate-500 font-normal">
                    Hola, <span class="text-teal-700 font-bold"><%= usuario.nombre %></span>
                </span>
                <form action="/autenticacion/logout" method="POST" class="inline">
                    <button type="submit"    class="inline-block bg-red-600 text-white px-6 py-2 rounded-xl font-bold hover:bg-red-700 transition shadow-lg shadow-red-100">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        <% } else { %>
            <a href="/autenticacion/login" class="inline-block bg-teal-600 text-white px-6 py-2 rounded-xl font-bold hover:bg-teal-700 transition shadow-lg shadow-teal-100">
                Iniciar sesión
            </a>
        <% } %>
    </div>
</nav>
