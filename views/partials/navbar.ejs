<!-- views/partials/navbar.ejs -->
<nav class="flex justify-between items-center p-6 bg-white shadow-sm">
    <!-- Contenedor del Logo y Nombre -->
    <div class="flex items-center space-x-3">
        <img src="/images/icon.svg" alt="Logo <%= nombreClinica %>" class="w-8 h-8">
        <div class="font-bold text-2xl text-teal-600 tracking-tight">
            <%= nombreClinica %>
        </div>
    </div>

    <!-- Enlaces de Navegación -->
    <div class="flex items-center space-x-6 font-semibold text-sm">
        <a href="/" class="<%= rutaActual === '/' ? 'text-teal-600 font-bold' : 'text-slate-600 hover:text-teal-600' %>">
            Inicio
        </a>
        <a href="/servicios" class="<%= rutaActual === '/servicios' ? 'text-teal-600 font-bold' : 'text-slate-600 hover:text-teal-600' %>">
            Servicios
        </a>
        <a href="/contacto" class="<%= rutaActual === '/contacto' ? 'text-teal-600 font-bold' : 'text-slate-600 hover:text-teal-600' %>">
            Contacto
        </a>

        <% if (usuario) { %>
            <!-- Vista protegida: Marcado dinámico para Registro de Mascotas -->
            <a href="/mascotas" class="<%= rutaActual === '/mascotas' ? 'text-teal-600 font-bold' : 'text-slate-600 hover:text-teal-600' %>">
                Registro de mascotas
            </a>

            <span class="text-teal-700 font-bold bg-teal-50 px-3 py-1 rounded-full">
                Hola, <%= usuario.nombre %>
            </span>
            <form action="/autenticacion/logout" method="POST" class="inline">
                <button type="submit" class="text-red-500 hover:text-red-700 font-semibold">
                    Cerrar sesión
                </button>
            </form>
        <% } else { %>
            <a href="/autenticacion/login" class="px-4 py-2 bg-teal-600 text-white font-semibold rounded-lg hover:bg-teal-700 transition">
                Iniciar sesión
            </a>
        <% } %>
    </div>
</nav>


