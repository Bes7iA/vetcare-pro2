<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="max-w-md mx-auto p-6">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-slate-800"><%= titulo %></h1>
        <p class="text-slate-500">Ingresa a tu cuenta de <%= clinica %></p>
    </div>

    <% if (error) { %>
        <div class="mb-4 p-3 bg-red-100 border border-red-300 text-red-700 text-sm rounded-lg">
            <%= error %>
        </div>
    <% } %>

    <form action="/login" method="POST" class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Nombre de Usuario</label>
            <input type="text" name="nombre" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Contraseña</label>
            <input type="password" name="clave" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
        </div>

        <!-- Botón Principal -->
        <button type="submit" class="w-full py-2.5 bg-teal-600 text-white font-semibold rounded-lg hover:bg-teal-700 transition">
            Iniciar Sesión
        </button>

        <!-- Separador Visual -->
        <div class="relative flex py-2 items-center">
            <div class="flex-grow border-t border-slate-200"></div>
            <span class="flex-shrink mx-3 text-xs text-slate-400 uppercase font-semibold">O</span>
            <div class="flex-grow border-t border-slate-200"></div>
        </div>

        <!-- Botón Secundario de Registro -->
        <a href="/registro" class="block w-full text-center py-2.5 bg-slate-100 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition">
            Crear cuenta nueva
        </a>
    </form>
</main>

<%- include('partials/footer') %>