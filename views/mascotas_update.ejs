<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="max-w-xl mx-auto p-6">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800"><%= titulo %></h1>
        <p class="text-slate-500"><%= clinica %></p>
    </div>

    <form action="/mascotas/<%= mascota.id %>/editar" method="POST" class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
        <!-- DUEÑO -->
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Nombre del Dueño</label>
            <input type="text" name="dueno" value="<%= mascota.dueno || '' %>" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
        </div>

        <!-- NOMBRE MASCOTA -->
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Nombre de la Mascota</label>
            <input type="text" name="nombre" value="<%= mascota.nombre %>" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Especie</label>
                <select name="especie" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
                    <option value="Perro" <%= mascota.especie === 'Perro' ? 'selected' : '' %>>Perro</option>
                    <option value="Gato" <%= mascota.especie === 'Gato' ? 'selected' : '' %>>Gato</option>
                    <option value="Exótico" <%= mascota.especie === 'Exótico' ? 'selected' : '' %>>Exótico</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Raza</label>
                <input type="text" name="raza" value="<%= mascota.raza || '' %>" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
            </div>
        </div>

        <!-- EDAD Y SEXO -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Edad (años)</label>
                <input type="number" name="edad" required min="0" step="1" value="<%= mascota.edad %>" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Sexo</label>
                <select name="sexo" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none bg-white">
                    <option value="Macho" <%= mascota.sexo === 'Macho' ? 'selected' : '' %>>Macho</option>
                    <option value="Hembra" <%= mascota.sexo === 'Hembra' ? 'selected' : '' %>>Hembra</option>
                </select>
            </div>
        </div>

        <!-- PESO Y ESTERILIZADO -->
        <div class="grid grid-cols-2 gap-4 items-center">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Peso (kg)</label>
                <input type="number" step="0.01" name="peso_kg" value="<%= mascota.peso_kg || '' %>" class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
            </div>
            <div class="flex items-center gap-2 pt-6">
                <input type="checkbox" id="esterilizado" name="esterilizado" <%= mascota.esterilizado ? 'checked' : '' %> class="w-4 h-4 text-teal-600 rounded">
                <label for="esterilizado" class="text-sm text-slate-700 font-medium">¿Esterilizado?</label>
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
            <a href="/mascotas" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-50">Cancelar</a>
            <button type="submit" class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-semibold hover:bg-amber-700">Actualizar Mascota</button>
        </div>
    </form>
</main>

<%- include('partials/footer') %>